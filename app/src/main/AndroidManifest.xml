<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.zayad.megaclipboard">
    <application android:allowBackup="true" android:label="MegaClipboard" android:supportsRtl="true" android:theme="@android:style/Theme.DeviceDefault.Light">
        <service android:name=".ClipboardKeyboard" android:label="MegaClipboard C++" android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
