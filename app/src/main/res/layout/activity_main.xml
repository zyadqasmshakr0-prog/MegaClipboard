<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F5F5">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="#2196F3" android:padding="10dp">
        <Button android:id="@+id/tab_temp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:backgroundTint="#FFFFFF" android:textColor="#2196F3" android:textStyle="bold" android:layout_marginEnd="5dp"/>
        <Button android:id="@+id/tab_pinned" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:backgroundTint="#81D4FA" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginStart="5dp"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp">
        <LinearLayout android:id="@+id/main_history_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>
</LinearLayout>
